filters:
  and:
    - file.inFolder("papers")
properties:
  note.star:
    displayName: 星标
  file.name:
    displayName: 论文
  note.source:
    displayName: 来源
  note.tags:
    displayName: 主题
views:
  - type: table
    name: 全部论文
    order:
      - note.star
      - file.name
      - note.source
      - note.tags
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: 已星标
    filters:
      and:
        - note.star == true
    order:
      - note.star
      - file.name
      - note.source
      - note.tags
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: Anthropic
    filters:
      and:
        - note.lab.contains("Anthropic")
    order:
      - note.star
      - file.name
      - note.source
      - note.tags
    sort:
      - property: note.date
        direction: DESC
  - type: table
    name: OpenAI
    filters:
      and:
        - note.lab.contains("OpenAI")
    order:
      - note.star
      - file.name
      - note.source
      - note.tags
    sort:
